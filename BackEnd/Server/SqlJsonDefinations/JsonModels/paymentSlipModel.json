			{
				"statement": "update",
				"query": "UPDATE a SET a.paymentType = 'SUPPLIER', a.voucherCode = ISNULL(NULLIF(a.voucherCode, ''), 'Z06'), a.status = ISNULL(NULLIF(a.status, ''), '0'), a.htttType = 'CK', a.spentMoney = 0, a.datetime0 = ISNULL(a.datetime0, GETDATE()) FROM paymentSlip@partition a INNER JOIN #TempTableName t ON a.idGui = t.idGui;exec [UpdateImportPhieuChi] 'paymentslip@partition', '#TempTableName';"
			}
