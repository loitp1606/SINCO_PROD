      "dataProcessing": {
        "sqlStatements": [
          {
            "statement": "update",
            "query": "
		
			declare @sbg varchar(50), @up_i int, @zid varchar (50);
			SELECT @zid = idGui FROM #TempTableName;
			exec [UpdateImportBaoGia]  'quotationPaperDetail@partition', @zid
			
			UPDATE qd SET qd.uom = i.uom, qd.taxCode = t.tax_id, qd.tax_rate = t.tax_number, qd.amount = ISNULL(qd.price,0) * ISNULL(qd.quantity,0), qd.vat = v.calculated_vat, qd.payment = ISNULL(qd.price,0) * ISNULL(qd.quantity,0) + v.calculated_vat FROM quotationPaperDetail@partition qd JOIN #TempTableName tt ON qd.idGui = tt.idGui CROSS APPLY (SELECT TOP 1 tax_id, tax_number FROM tax WHERE tax_number = qd.tax_rate AND status = 1 ORDER BY tax_id) t CROSS APPLY (SELECT ISNULL(qd.price,0) * ISNULL(qd.quantity,0) * ISNULL(t.tax_number,0) / 100 AS calculated_vat) v JOIN item i WITH (NOLOCK) ON qd.itemCode = i.item_id; UPDATE q SET q.total_quantity = qd.total_quantity, q.total_amount = qd.total_amount, q.total_vat = qd.total_vat, q.total_payment = qd.total_payment FROM QuotationPaper@partition q INNER JOIN (SELECT idGui, SUM(ISNULL(quantity,0)) AS total_quantity, SUM(ISNULL(amount,0)) AS total_amount, SUM(ISNULL(vat,0)) AS total_vat, SUM(ISNULL(payment,0)) AS total_payment FROM quotationPaperDetail@partition WHERE idGui IN (SELECT idGui FROM #TempTableName) GROUP BY idGui) qd ON q.idGui = qd.idGui; insert into itemsearch (item_id, item_name, Vector, vector_dim, datetime0, idGui, nha_san_xuat) select itemCode, itemNameCustomer, null, 768 , getdate(), idGui, nha_san_xuat from quotationPaperDetail@partition a WHERE idGui IN (SELECT idGui FROM #TempTableName) and not exists (select 1 from itemsearch z WITH (NOLOCK, INDEX = idGui) where a.idGui = z.idGui); insert into QuotationPaper$000000 (idGui, idVC, unitCode, customerCode, voucherCode, voucherDate, voucherNumber) select idGui, idVC, unitCode, customerCode, 'Z02', voucherDate, voucherNumber from quotationPaper@partition a WHERE idGui IN (SELECT idGui FROM #TempTableName) and not exists (select 1 from QuotationPaper$000000 z WITH (NOLOCK) where a.idGui = z.idGui);
						
						select @up_i = 0, @sbg = prefix + rtrim(year(getdate())) + replace(str(month(getdate()), 2), ' ', '0') + right('0000000000'+ rtrim((currentNumber + 1)), NumberLength)
	from VoucherSequence
		where Controller = 'QuotationPaper' and Field = 'voucherNumber';
update quotationPaper@partition set trang_thai_duyet = 0, ten_trang_thai = N'Chưa chuyển đơn đặt hàng'  WHERE idGui = @zid;		
update quotationPaper@partition set @up_i = 1,voucherNumber  = @sbg  WHERE idGui = @zid and isnull(voucherNumber,'') = 'SINCO';
					
insert into itemsearch (item_id, item_name, Vector, vector_dim, datetime0, idGui, nha_san_xuat)
	select itemCode, itemNameCustomer, null, 768 , getdate(), @zid, nha_san_xuat 
	from quotationPaperDetail@partition a WHERE idGui = @zid and not exists (select 1 from itemsearch z WITH (NOLOCK, INDEX = idGui) where a.idGui = z.idGui)
					
insert into QuotationPaper$000000 (idGui, idVC, unitCode, customerCode, voucherCode, voucherDate, voucherNumber)
	select idGui, idVC, unitCode, customerCode, 'Z02', voucherDate, voucherNumber
	from quotationPaper@partition a 
		WHERE idGui = @zid and not exists (select 1 from QuotationPaper$000000 z WITH (NOLOCK) where a.idGui = z.idGui)
					
					
exec [sp_UpdateNullsToDefault] 'quotationPaper@partition', @zid
exec [sp_UpdateNullsToDefault] 'quotationPaperDetail@partition', @zid
update VoucherSequence set currentNumber = currentNumber + 1, LastResetDate = getdate(), UpdatedDate = getdate() from VoucherSequence
		where Controller = 'QuotationPaper' and Field = 'voucherNumber' and @up_i = 1;
		"																																																 
          }
