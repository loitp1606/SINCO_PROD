        "message": "voucherNumber không được để trống và tối đa 32 ký tự."
      },
      {
        "fieldName": "voucherNumber",
        "type": "databaseCheck",
        "checkQuery": "WHERE voucherNumber = @voucherNumber and status <> '*'",
        "overWrite": true,
        "threshold": "0",
        "message": "voucherNumber đã tồn tại trong hệ thống."
      }
