      "dataProcessing": {
        "sqlStatements": [
          {
            "statement":  "update",
            "query": "IF NOT EXISTS (SELECT 1 FROM ContractDetail@partition WHERE idGui = @idGui AND line_nbr = @line_nbr) THROW 51002, 'Chi tiết hợp đồng không tồn tại', 1; UPDATE ContractDetail@partition SET item_id = @item_id, item_name = @item_name, uomCode = @uomCode, quantity = @quantity, tax_rate = @tax_rate, price = @price, note = @note, amount = ISNULL(TRY_CONVERT(NUMERIC(24, 4), @price), 0) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @quantity), 0), tax = (ISNULL(TRY_CONVERT(NUMERIC(24, 4), @price), 0) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @quantity), 0)) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @tax_rate), 0) / 100, payment = (ISNULL(TRY_CONVERT(NUMERIC(24, 4), @price), 0) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @quantity), 0)) + ((ISNULL(TRY_CONVERT(NUMERIC(24, 4), @price), 0) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @quantity), 0)) * ISNULL(TRY_CONVERT(NUMERIC(24, 4), @tax_rate), 0) / 100) WHERE idGui = @idGui AND line_nbr = @line_nbr; UPDATE c SET c.amount_total = d.TotalPayment FROM Contract@partition c INNER JOIN (SELECT idGui, SUM(ISNULL(payment, 0)) AS TotalPayment FROM ContractDetail@partition WHERE idGui = @idGui GROUP BY idGui) d ON c.idGui = d.idGui WHERE c.idGui = @idGui;"
          }
        ]
      }
