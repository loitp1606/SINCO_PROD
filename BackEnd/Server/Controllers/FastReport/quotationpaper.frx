		using FastReport.Data;
		using FastReport.Dialog;
		using FastReport.Barcode;
		using FastReport.Table;
		using FastReport.Utils;

		namespace FastReport
		{
		  public class ReportScript
		  {
         public string qNote; 
         public void IsNote(object sender, EventArgs e){
         object quotationNote = Report.GetColumnValue(&quot;quotationpaper.note&quot;); 
        if(quotationNote != null &amp;&amp; !string.IsNullOrEmpty(quotationNote.ToString()))
        {
            qNote = &quot;&lt;b&gt;&lt;u&gt;Ghi chú&lt;/u&gt;&lt;/b&gt;\n&quot; + quotationNote.ToString();
        }
        else{
          qNote = &quot;&quot;;
        }
      }
  		}
		}
	</ScriptText>
