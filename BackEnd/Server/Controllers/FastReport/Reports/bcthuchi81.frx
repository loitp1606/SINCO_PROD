<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="12/23/2025 21:48:33" ReportInfo.Modified="01/10/2026 15:30:36" ReportInfo.CreatorVersion="2026.1.3.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    // Hàm này gắn vào sự kiện OnBeforePrint của Memo/TextObject trong report
    private void Memo1_BeforePrint(object sender, EventArgs e)
    {
      var memo = sender as FastReport.TextObject;

      DateTime? dateFrom = Report.GetColumnValue(&quot;param.dateFrom&quot;) as DateTime?;
      DateTime? dateTo   = Report.GetColumnValue(&quot;param.dateTo&quot;) as DateTime?;

      string text = &quot;&quot;;

      if (dateFrom.HasValue)
        text = &quot;Từ ngày: &quot; + dateFrom.Value.ToString(&quot;dd/MM/yyyy&quot;);

      if (dateTo.HasValue)
      {
        if (text != &quot;&quot;)
          text += &quot; - &quot;;
        text += &quot;Đến ngày: &quot; + dateTo.Value.ToString(&quot;dd/MM/yyyy&quot;);
      }

      memo.Text = text;
    }
  }
}
</ScriptText>
  <Dictionary>
    <TableDataSource Name="param" ReferenceName="ReportData.param" DataType="System.Int32" Enabled="true">
      <Column Name="dateFrom" DataType="System.DateTime"/>
      <Column Name="dateTo" DataType="System.DateTime"/>
      <Column Name="accountSinco" DataType="System.String"/>
      <Column Name="userId" DataType="System.Int32"/>
      <Column Name="language" DataType="System.String"/>
    </TableDataSource>
    <TableDataSource Name="rp" ReferenceName="ReportData.bcthuchi81" DataType="System.Int32" Enabled="true">
      <Column Name="sysorder" DataType="System.Int32"/>
      <Column Name="systotal" DataType="System.Int32"/>
      <Column Name="sysprint" DataType="System.Int32"/>
      <Column Name="stt" DataType="System.Int32"/>
      <Column Name="customerCode" DataType="System.String"/>
      <Column Name="ngay_hl" DataType="System.DateTime"/>
      <Column Name="ngay_gd" DataType="System.DateTime"/>
      <Column Name="note_detail" DataType="System.String"/>
      <Column Name="note_master" DataType="System.String"/>
      <Column Name="thu" DataType="System.Decimal"/>
      <Column Name="chi" DataType="System.Decimal"/>
      <Column Name="so_du" DataType="System.Decimal"/>
      <Column Name="xtype" DataType="System.Int32"/>
    </TableDataSource>
  </Dictionary>
