      <TextObject Name="Text35" Top="56.7" Width="359.1" Height="18.9" Text="(Ký, ghi rõ họ tên)" HorzAlign="Center" Font="Times New Roman, 9pt, style=Italic"/>
      <TextObject Name="Text36" Left="359.1" Top="37.8" Width="359.1" Height="18.9" Text="ĐẠI DIỆN BÊN BÁN" HorzAlign="Center" VertAlign="Center" Font="Times New Roman, 12pt, style=Bold"/>
      <TextObject Name="Text39" Left="359.1" Top="56.7" Width="359.1" Height="18.9" Text="(Ký, ghi rõ họ tên)" HorzAlign="Center" Font="Times New Roman, 9pt, style=Italic"/>
