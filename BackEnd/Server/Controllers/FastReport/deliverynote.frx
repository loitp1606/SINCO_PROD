      <TextObject Name="Text126" Top="37.8" Width="718.2" Height="47.25" CanGrow="true" Text="&lt;b&gt;&lt;u&gt;GHI CHÚ:&lt;/u&gt;&lt;/b&gt; &#13;&#10;Quý khách hàng vui lòng kiểm tra hàng hóa trong vòng 02 ngày (48 giờ) kể từ lúc nhận hàng. Sau khoảng thời gian trên chúng tôi không có cơ sở để kiểm tra, giải quyết khiếu nại cho Quý khách. Xin cảm ơn." Font="Arial, 10pt, style=Bold" TextRenderType="HtmlTags"/>
