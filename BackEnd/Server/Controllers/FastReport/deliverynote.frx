  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    public string phoneFax = &quot;&quot;;
    public void handelPhoneAndFax(object sender, EventArgs e){
      string phone   = ((String)Report.GetColumnValue(&quot;deliverynote.phonePersonCreate&quot;));
      string fax   = ((String)Report.GetColumnValue(&quot;deliverynote.faxPersonCreate&quot;));
      phoneFax = !string.IsNullOrEmpty(fax) ? phone + &quot; - &quot; + fax : phone;
    }
  }
}
</ScriptText>
