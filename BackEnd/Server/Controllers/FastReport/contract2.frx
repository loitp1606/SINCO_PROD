<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="07/31/2025 16:53:50" ReportInfo.Modified="07/02/2026 21:54:20" ReportInfo.CreatorVersion="2025.1.10.0">
  <ScriptText>
		using System;
		using System.Collections;
		using System.Collections.Generic;
		using System.ComponentModel;
		using System.Windows.Forms;
		using System.Drawing;
		using System.Data;
		using FastReport;
		using FastReport.Data;
		using FastReport.Dialog;
		using FastReport.Barcode;
		using FastReport.Table;
		using FastReport.Utils;

		namespace FastReport
		{
		public class ReportScript
		{
		public decimal totalPrice;
		public decimal totalVAT;
		public decimal total;
		public string address;

		public void OnStartReport()
		{
		totalPrice = 0;
		totalVAT = 0;
		total = 0;
		}

		public void DetailBand_BeforePrint(object sender, EventArgs e)
		{
		object price = Report.GetColumnValue(&quot;contractDetail.price&quot;);
		object vat = Report.GetColumnValue(&quot;contractDetail.tax_rate&quot;);
		object quantity = Report.GetColumnValue(&quot;contractDetail.quantity&quot;);
		if (price != null &amp;&amp; price != DBNull.Value)
		totalPrice += (Convert.ToDecimal(price) * Convert.ToDecimal(quantity));

		if (price != null &amp;&amp; price != DBNull.Value &amp;&amp; vat != null &amp;&amp; vat != DBNull.Value)
		totalVAT += totalPrice * Convert.ToDecimal(vat) / 100m;

		total = totalPrice + totalVAT;
		}
		public void DefaultAddress(object sender, EventArgs e)
		{
		var addr = Report.GetColumnValue(&quot;contract.address&quot;);
		if (addr != null &amp;&amp; !string.IsNullOrEmpty(addr.ToString()))
		{
		address = addr.ToString();
		}
		else
		{
		address = &quot;489/9 Khu Phố 1, P. Bình Hưng Hoà A, Q. Bình Tân, TPHCM&quot;;
		}
		}
		}
		}
	</ScriptText>
