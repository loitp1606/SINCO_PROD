{
	"controller": "goodsReceipt",
	"type": "voucher",
	"formId": "goodsReceipt",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z10",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Phiếu nhập hàng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin phiếu nhập hàng",
				"class": "",
				"formId": "goodsReceipt",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"autoIncrement": true,
						"required": true,
						"placeholder": "Số phiếu",
						"autoGenerate": true,
						"width": "100px"
					},
					{
						"key": "poin_number",
						"label": "Số ĐHN",
						"type": "text",
						"placeholder": "Số ĐHN",
						"width": "100px"
					},
					{
						"key": "receiveStatus",
						"label": "TT nhận hàng",
						"type": "select",
						"width": "150px",
						"options": [
							{
								"label": "Chưa nhận hàng",
								"value": "NOT_RECEIVED"
							},
							{
								"label": "Chưa nhận một phần",
								"value": "PARTIAL"
							},
							{
								"label": "Đã nhận hàng",
								"value": "RECEIVED"
							}
						]
					},
					{
						"key": "voucherDate",
						"label": "Ngày chứng từ",
						"required": true,
						"default": "now",
						"type": "date",
						"placeholder": "Chọn ngày chứng từ",
						"width": "100px"
					},
					{
						"key": "supplierCode",
						"label": "Mã cung cấp",
						"required": true,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "Supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"supplierCode"
							],
							"dataType": [
								"String"
							],
							"query": "select  isnull (address, '') as addressSupplier, isnull (phone_number, '') as phoneSupplier , isnull (email, '') as emailSupplier, isnull (supplier_id, '') as invoiceCustomerCode from supplier where supplier_id = @supplierCode",
							"map": {
								"addressSupplier": "addressSupplier",
								"phoneSupplier": "phoneSupplier",
								"emailSupplier": "emailSupplier",
								"invoiceCustomerCode": "invoiceCustomerCode"
							}
						}
					},
					{
						"key": "invoiceCustomerCode",
						"label": "Mã NCC xuất HĐ",
						"required": false,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "Supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"width": "350px"
					},
					{
						"key": "addressSupplier",
						"label": "Địa chỉ",
						"type": "text",
						"width": "150px",
						"required": true,
						"placeholder": ""
					},
					{
						"key": "phoneSupplier",
						"label": "Điện thoại",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "emailSupplier",
						"label": "Email",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "employeeCode",
						"label": "Nhân viên",
						"required": true,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "term",
						"label": "Kỳ hạn thanh toán",
						"type": "number",
						"width": "100px",
						"placeholder": ""
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "paidAmount",
						"label": "Đã thanh toán",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"width": "100px"
					},
					{
						"key": "debtAmount",
						"label": "Còn phải trả",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"width": "100px"
					},
					{
						"key": "paymentStatus",
						"label": "TT thanh toán",
						"type": "select",
						"width": "150px",
						"disabled": false,
						"options": [
							{
								"label": "Chưa chi",
								"value": "UNPAID"
							},
							{
								"label": "Đã chi một phần",
								"value": "PARTIAL"
							},
							{
								"label": "Đã chi",
								"value": "PAID"
							}
						]
					},
					{
						"key": "totalQuantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalQuantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalAmount",
						"label": "Tổng tiền",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalAmount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalDiscount",
						"label": "Tổng chiết khấu",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalDiscount] = SUM([discount])",
									"dependencies": [
										"discount"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalTax",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalTax] = SUM([tax])",
									"dependencies": [
										"tax"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalPayment",
						"label": "Tổng thanh toán",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[totalPayment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "status",
						"default": "0",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Đang chờ nhập",
								"value": "0"
							},
							{
								"label": "Đã chi tiền",
								"value": "1"
							}
						]
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "goodsReceiptDetail",
					"formId": "goodsReceiptDetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "40px"
						},
						{
							"key": "item_id",
							"label": "Mã vật tư",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"item_id",
									"uom"
								],
								"dataType": [
									"String",
									"String"
								],
								"query": "exec GoodsReceiptValidItem @item_id, @uom",
								"map": {
									"uom": "uom",
									"itemNameVAT": "itemNameVAT",
									"price": "price"
								}
							}
						},
						{
							"key": "itemNameVAT",
							"label": "Tên VT xuất HĐ",
							"type": "text",
							"width": "450px",
							"required": false,
							"quickEditable": true
						},
						{
							"key": "uom",
							"label": "Đơn vị tính",
							"required": true,
							"type": "lookup",
							"width": "100px",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "quantity",
							"label": "Số lượng",
							"required": true,
							"type": "number",
							"precision": 2,
							"width": "100px",
							"trigger": [
								"amount",
								"tax",
								"payment"
							]
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"width": "100px",
							"currency": "VN",
							"precision": 2,
							"trigger": [
								"amount",
								"tax",
								"payment"
							]
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price]",
										"dependencies": [
											"quantity",
											"price"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "ratioDiscount",
							"label": "% Chiết khấu",
							"required": false,
							"width": "100px",
							"type": "number",
							"trigger": [
								"discount",
								"payment"
							]
						},
						{
							"key": "discount",
							"label": "Tiền chiết khấu",
							"type": "number",
							"precision": 2,
							"currency": "VN",
							"width": "100px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[discount] = [amount] * [ratioDiscount] / 100",
										"dependencies": [
											"amount",
											"ratioDiscount"
										],
										"precision": 2
									}
								]
							}
						},
						{
							"key": "taxCode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "200px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxCode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as tax_rate from tax where tax_id = @taxCode",
								"map": {
									"tax_rate": "tax_rate"
								}
							}
						},
						{
							"key": "tax_rate",
							"label": "Thuế suất",
							"required": false,
							"width": "100px",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							]
						},
						{
							"key": "tax",
							"label": "Thuế tax",
							"type": "number",
							"currency": "VN",
							"width": "100px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[tax] = [amount] * [tax_rate] / 100",
										"dependencies": [
											"amount",
											"tax_rate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] + [tax] - [discount]",
										"dependencies": [
											"amount",
											"tax",
											"discount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "invoiceNumber",
							"label": "Số hóa đơn",
							"type": "text",
							"width": "170px",
							"required": false,
							"quickEditable": true
						},
						{
							"key": "invoiceDate",
							"label": "Ngày hóa đơn",
							"type": "date",
							"width": "140px",
							"required": false,
							"quickEditable": true
						},
						{
							"key": "isReceived",
							"label": "Đã nhận hàng",
							"type": "checkbox",
							"width": "130px",
							"required": false,
							"quickEditable": true
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"popupActions": [
		{
			"id": "supplierDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ nhà cung cấp",
				"depositLabel": "Tiền đặt hàng",
				"receivableLabel": "Tiền đã chi",
				"payableLabel": "Còn phải trả",
				"depositField": "depositAmount",
				"receivableField": "paidAmount",
				"payableField": "payableAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetSupplierDebtSummary @supplierCode, @unitCode",
					"params": [
						"supplierCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@supplierCode",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "paidAmount",
						"payable": "payableAmount"
					}
				}
			}
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdateGoodsReceipt N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdateGoodsReceipt N'@idGui', N'@voucherNumber', N'@voucherDate';"
				}
			]
		}
	}
}
