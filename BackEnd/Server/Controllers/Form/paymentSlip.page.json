{
	"controller": "PaymentSlip",
	"type": "voucher",
	"formId": "paymentSlip",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z06",
	"VCDate": "voucherDate",
	"title": "Phiếu chi",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Phiếu chi",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin phiếu chi",
				"class": "",
				"formId": "paymentSlip",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"required": true,
						"autoIncrement": true,
						"autoGenerate": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "voucherDate",
						"label": "Ngày",
						"type": "date",
						"required": true,
						"default": "now",
						"width": "100px"
					},
					{
						"key": "paymentType",
						"label": "Loại chi",
						"type": "select",
						"width": "150px",
						"required": true,
						"default": "DEPOSIT",
						"quickEditable": true,
						"options": [
							{
								"label": "Chi tiền đặt cọc",
								"value": "DEPOSIT"
							},
							{
								"label": "Chi công nợ trực tiếp",
								"value": "SUPPLIER"
							},
							{
								"label": "Chi công nợ từ tiền đặt cọc",
								"value": "DEPOSIT_OFFSET"
							},
							{
								"label": "Chi khác",
								"value": "OTHER"
							}
						]
					},
					{
						"key": "supplierCode",
						"label": "Nhà cung cấp",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"supplierCode"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull(s.address,'') as supplierAddress, isnull(d.depositAmount,0) as depositAmount from supplier s outer apply (select sum(case when upper(isnull(ReceiptType,'')) in ('DEPOSIT','PAYMENT_DEPOSIT','PAYMENT_DEPOSIT_OFFSET','SUPPLIER_ADVANCE') then isnull(try_convert(decimal(24,6), AdvanceAmount),0) else 0 end) as depositAmount from SupplierDebtLedger where SupplierId = s.supplier_id) d where s.supplier_id = @supplierCode",
							"map": {
								"supplierAddress": "supplierAddress",
								"depositAmount": "depositAmount"
							}
						}
					},
					{
						"key": "supplierAddress",
						"label": "Địa chỉ NCC",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "depositAmount",
						"label": "Tiền đặt cọc hiện có",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"readonly": true,
						"transient": true,
						"width": "150px",
						"required": false,
						"visibleWhen": {
							"field": "paymentType",
							"operator": "=",
							"value": "DEPOSIT_OFFSET"
						}
					},
					{
						"key": "cashier",
						"label": "Nhân viên chi",
						"type": "lookup",
						"width": "150px",
						"required": false,
						"multiple": false,
						"default": {
							"controller": "employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "reason",
						"label": "Lý do chi",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "Incomeexpenditure",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								},
								{
									"field": "type",
									"value": "2",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "invoiceNumber",
						"label": "Số hóa đơn",
						"type": "hidden",
						"width": "150px",
						"required": false
					},
					{
						"key": "bank_name",
						"label": "Ngân hàng",
						"type": "lookup",
						"width": "150px",
						"required": false,
						"placeholder": "Chọn ngân hàng",
						"default": {
							"controller": "bank",
							"filter": []
						}
					},
					{
						"key": "htttType",
						"label": "Loại thanh toán",
						"type": "select",
						"width": "150px",
						"default":"CK",
						"required": true,
						"options": [
							{
								"label": "Tiền mặt",
								"value": "TM"
							},
							{
								"label": "Chuyển khoản",
								"value": "CK"
							},
							{
								"label": "TM/CK",
								"value": "TM/CK"
							}
						]
					},
					{
						"key": "spentMoney",
						"label": "Đã chi",
						"type": "checkbox",
						"quickEditable": true,
						"width": "100px"
					},
					{
						"key": "dien_giai",
						"label": "Diễn giải",
						"type": "textarea",
						"width": "150px",
						"required": false,
						"placeholder": "Nhập diễn giải"
					},
					{
						"key": "status",
						"label": "Trạng thái",
						"type": "hidden",
						"width": "150px",
						"default":"1",
						"required": false,
						"options": [
							{
								"label": "Tạo phiếu",
								"value": "0"
							},
							{
								"label": "Xác nhận",
								"value": "1"
							}
						]
					},
					{
						"key": "allocationJson",
						"label": "Dữ liệu phân bổ",
						"type": "hidden",
						"required": false
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"required": false
					},
					{
						"key": "total_amount",
						"label": "Số tiền chi (*)",
						"type": "number",
						"currency": "VN",
						"disabled": false,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_amount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Danh sách phiếu nhập còn phải trả",
					"quickEditable": true,
					"allowAdd": false,
					"allowDelete": false,
					"allowMove": false,
					"allowSelect": false,
					"visibleWhen": {
						"field": "paymentType",
						"operator": "in",
						"value": [
							"SUPPLIER",
							"DEPOSIT_OFFSET"
						]
					},
					"controllerDetail": "PaymentSlipDetail",
					"formId": "paymentSlipdetail",
					"foreignKey": "idGui, line_nbr",
					"autoLoad": {
						"whenFieldsChange": [
							"paymentType",
							"supplierCode"
						],
						"clearWhenEmpty": true,
						"dataSource": {
							"api": "/api/CustomQuery/execute",
							"query": "exec dbo.sp_GetSupplierPaymentAllocation @mode, @idGui, @supplierCode, @unitCode, @keyword",
							"params": [
								"mode",
								"idGui",
								"supplierCode",
								"unitCode",
								"keyword"
							],
							"dataType": [
								"String",
								"String",
								"String",
								"String",
								"String"
							],
							"values": [
								"EDIT",
								"@idGui",
								"@supplierCode",
								"@unitCode",
								""
							]
						},
						"map": {
							"idGuiPN": "refIdGuiPN",
							"lnPN": "refLineNbrPN",
							"invoiceNumber": "voucherNumber",
							"invoiceDate": "voucherDate",
							"invoiceAmount": "payableAmount",
							"paidAmount": "paidAmount",
							"debtAmount": "outstandingAmount",
							"amount": "allocatedAmount",
							"note": "note"
						}
					},
					"allocationJson": {
						"enabled": true,
						"allocationJsonField": "allocationJson",
						"receiptAmountField": "total_amount",
						"receiptTypeField": "paymentType",
						"lineNbrField": "line_nbr",
						"refIdGuiField": "idGuiPN",
						"refLineNbrField": "lnPN",
						"voucherNumberField": "invoiceNumber",
						"invoiceDateField": "invoiceDate",
						"invoiceAmountField": "invoiceAmount",
						"outstandingAmountField": "debtAmount",
						"allocatedAmountField": "amount",
						"noteField": "note"
					},
					"autoAllocate": {
						"enabled": true,
						"label": "Phân bổ tự động",
						"clearLabel": "Xóa phân bổ",
						"receiptTypes": [
							"DEPOSIT_OFFSET"
						],
						"sourceAmountField": "depositAmount",
						"targetTotalField": "total_amount",
						"outstandingAmountField": "debtAmount",
						"allocatedAmountField": "amount"
					},
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"valueType": "number",
							"width": "40px"
						},
						{
							"key": "invoiceNumber",
							"label": "Số phiếu nhập",
							"type": "text",
							"disabled": true,
							"required": true,
							"width": "160px"
						},
						{
							"key": "invoiceDate",
							"label": "Ngày nhập",
							"type": "date",
							"disabled": true,
							"required": false,
							"width": "130px"
						},
						{
							"key": "invoiceAmount",
							"label": "Tiền phiếu nhập",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"required": false,
							"width": "100px",
							"trigger": [
								"debtAmount"
							]
						},
						{
							"key": "paidAmount",
							"label": "Đã chi",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"required": false,
							"width": "100px",
							"trigger": [
								"debtAmount"
							]
						},
						{
							"key": "debtAmount",
							"label": "Còn phải trả",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"width": "100px",
							"precision": 0,
							"calculation": {
								"calculations": [
									{
										"formula": "[debtAmount] = [invoiceAmount] - [paidAmount]",
										"dependencies": [
											"invoiceAmount",
											"paidAmount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "amount",
							"label": "Số tiền chi",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"required": true
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"width": "220px",
							"type": "text",
							"uiTab": "Ghi chú"
						},
						{
							"key": "idGuiPN",
							"label": "Key phiếu nhập",
							"type": "hidden"
						},
						{
							"key": "lnPN",
							"label": "Dòng phiếu nhập",
							"type": "hidden",
							"valueType": "number"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdatePaymentSlip N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdatePaymentSlip N'@idGui', N'@voucherNumber', N'@voucherDate';EXEC dbo.sp_PostDebtFromPaymentSlip N'@idGui', N'@unit', N'@userId';IF UPPER(N'@paymentType') IN (N'SUPPLIER', N'DEPOSIT_OFFSET') EXEC dbo.sp_SaveSupplierPaymentAllocation N'@idGui', N'@allocationJson', N'@unit', N'@userId';IF UPPER(N'@paymentType') IN (N'SUPPLIER', N'DEPOSIT_OFFSET') EXEC dbo.sp_ApplySupplierPaymentAllocationFromPaymentSlip N'@idGui', N'@unit', N'@userId';"
				}
			]
		}
	},
	"popupActions": [
		{
			"id": "supplierDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ nhà cung cấp",
				"depositLabel": "Tiền đặt hàng",
				"receivableLabel": "Tiền đã chi",
				"payableLabel": "Còn phải trả",
				"depositField": "depositAmount",
				"receivableField": "paidAmount",
				"payableField": "payableAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetSupplierDebtSummary @supplierCode, @unitCode",
					"params": [
						"supplierCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@supplierCode",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "paidAmount",
						"payable": "payableAmount"
					}
				}
			}
		}
	]
}
