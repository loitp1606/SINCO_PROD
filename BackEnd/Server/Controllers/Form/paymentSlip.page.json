{
	"controller": "PaymentSlip",
	"type": "voucher",
	"formId": "paymentSlip",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z06",
	"VCDate": "voucherDate",
	"title": "Phiếu chi",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Phiếu chi",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin phiếu chi",
				"class": "",
				"formId": "paymentSlip",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"required": true,
						"autoIncrement": true,
						"autoGenerate": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "voucherDate",
						"label": "Ngày",
						"type": "date",
						"required": true,
						"default": "now",
						"width": "100px"
					},
					{
						"key": "receiptCode",
						"label": "Phiếu nhập hàng",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "paymentType",
						"label": "Loại chi",
						"type": "select",
						"width": "150px",
						"required": true,
						"default": "SUPPLIER",
						"quickEditable": true,
						"options": [
							{
								"label": "Chi tiền nhà cung cấp",
								"value": "SUPPLIER"
							},
							{
								"label": "Chi theo hóa đơn",
								"value": "INVOICE"
							},
							{
								"label": "Chi tiền đặt cọc",
								"value": "DEPOSIT"
							},
							{
								"label": "Chi từ tiền đặt cọc",
								"value": "DEPOSIT_OFFSET"
							}
						]
					},
					{
						"key": "supplierCode",
						"label": "Nhà cung cấp",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"supplierCode"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull(address,'') as supplierAddress from supplier where supplier_id = @supplierCode",
							"map": {
								"supplierAddress": "supplierAddress"
							}
						}
					},
					{
						"key": "supplierAddress",
						"label": "Địa chỉ NCC",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "cashier",
						"label": "Nhân viên chi",
						"type": "lookup",
						"width": "150px",
						"required": false,
						"multiple": false,
						"default": {
							"controller": "employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "reason",
						"label": "Lý do chi",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "Incomeexpenditure",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								},
								{
									"field": "type",
									"value": "2",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "invoiceNumber",
						"label": "Số hóa đơn",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "htttType",
						"label": "Loại thanh toán",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Tiền mặt",
								"value": "TM"
							},
							{
								"label": "Chuyển khoản",
								"value": "CK"
							},
							{
								"label": "TM/CK",
								"value": "TM/CK"
							}
						]
					},
					{
						"key": "status",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Tạo phiếu",
								"value": "0"
							},
							{
								"label": "Xác nhận",
								"value": "1"
							}
						]
					},
					{
						"key": "bank_name",
						"label": "Ngân hàng",
						"type": "lookup",
						"width": "150px",
						"required": false,
						"placeholder": "Chọn ngân hàng",
						"default": {
							"controller": "bank",
							"filter": []
						}
					},
					{
						"key": "spentMoney",
						"label": "Đã chi",
						"type": "checkbox",
						"quickEditable": true,
						"width": "100px"
					},
					{
						"key": "dien_giai",
						"label": "Diễn giải",
						"type": "textarea",
						"width": "150px",
						"required": false,
						"placeholder": "Nhập diễn giải"
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"required": false
					},
					{
						"key": "total_amount",
						"label": "Số tiền chi (*)",
						"type": "number",
						"currency": "VN",
						"disabled": false,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_amount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết chi theo hóa đơn",
					"quickEditable": true,
					"visibleWhen": {
						"field": "paymentType",
						"operator": "=",
						"value": "INVOICE"
					},
					"controllerDetail": "PaymentSlipDetail",
					"formId": "paymentSlipdetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "40px"
						},
						{
							"key": "invoiceNumber",
							"label": "Số hóa đơn",
							"type": "text",
							"required": true,
							"width": "160px"
						},
						{
							"key": "invoiceDate",
							"label": "Ngày HĐ",
							"type": "date",
							"required": false,
							"width": "130px"
						},
						{
							"key": "invoiceAmount",
							"label": "Tiền HĐ",
							"type": "number",
							"currency": "VN",
							"required": false,
							"width": "100px",
							"trigger": [
								"debtAmount"
							]
						},
						{
							"key": "paidAmount",
							"label": "Đã chi",
							"type": "number",
							"currency": "VN",
							"required": false,
							"width": "100px",
							"trigger": [
								"debtAmount"
							]
						},
						{
							"key": "debtAmount",
							"label": "Còn phải trả",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"width": "100px",
							"calculation": {
								"calculations": [
									{
										"formula": "[debtAmount] = [invoiceAmount] - [paidAmount]",
										"dependencies": [
											"invoiceAmount",
											"paidAmount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "amount",
							"label": "Số tiền chi",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"required": true
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"width": "220px",
							"type": "text",
							"uiTab": "Ghi chú"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdatePaymentSlip N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdatePaymentSlip N'@idGui', N'@voucherNumber', N'@voucherDate';EXEC dbo.sp_PostDebtFromPaymentSlip N'@idGui', N'@unit', N'@userId';EXEC dbo.sp_ApplySupplierPaymentAllocationFromPaymentSlip N'@idGui', N'@unit', N'@userId';"
				}
			]
		}
	},
	"popupActions": [
		{
			"id": "supplierDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ nhà cung cấp",
				"depositLabel": "Tiền đặt hàng",
				"receivableLabel": "Tiền đã chi",
				"payableLabel": "Còn phải trả",
				"depositField": "depositAmount",
				"receivableField": "paidAmount",
				"payableField": "payableAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetSupplierDebtSummary @supplierCode, @unitCode",
					"params": [
						"supplierCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@supplierCode",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "paidAmount",
						"payable": "payableAmount"
					}
				}
			}
		},
		{
			"id": "paymentAllocation",
			"label": "Phân bổ phải trả",
			"type": "receiptAllocation",
			"style": "primary",
			"showInView": false,
			"config": {
				"title": "Phân bổ chi theo hóa đơn",
				"receiptAmountField": "total_amount",
				"openInvoiceDataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec dbo.sp_GetSupplierPaymentAllocation @mode, @idGui, @supplierCode, @unitCode, @keyword",
					"params": [
						"mode",
						"idGui",
						"supplierCode",
						"unitCode",
						"keyword"
					],
					"dataType": [
						"String",
						"String",
						"String",
						"String",
						"String"
					],
					"values": [
						"EDIT",
						"@idGui",
						"@supplierCode",
						"@unitCode",
						"@keyword"
					]
				},
				"saveAllocationDataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec dbo.sp_SaveSupplierPaymentAllocation @idGui, @allocationJson, @unitCode, @userId",
					"params": [
						"idGui",
						"allocationJson",
						"unitCode",
						"userId"
					],
					"dataType": [
						"String",
						"String",
						"String",
						"String"
					],
					"values": [
						"@idGui",
						"@allocationJson",
						"@unit",
						"@userId"
					]
				}
			}
		}
	]
}
