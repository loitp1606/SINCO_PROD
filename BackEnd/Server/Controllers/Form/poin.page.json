{
	"controller": "poin",
	"type": "voucher",
	"formId": "poin",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z03",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Đơn đặt nhập hàng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin đơn đặt nhập hàng",
				"class": "",
				"formId": "poin",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"autoIncrement": true,
						"required": true,
						"placeholder": "Số phiếu",
						"autoGenerate": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "voucherDate",
						"label": "Ngày tạo",
						"type": "date",
						"default": "now",
						"required": true,
						"width": "100px"
					},
					{
						"key": "vendorGroupCode",
						"label": "Nhóm NCC",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "customerGroup",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "expectedDate",
						"label": "Ngày dự kiến",
						"type": "date",
						"width": "150px"
					},
					{
						"key": "approveDate",
						"label": "Ngày duyệt",
						"type": "date",
						"width": "150px"
					},
					{
						"key": "vendorCode",
						"label": "Mã NCC",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"vendorCode"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull (supplier_type_id, '') as vendorGroupCode, isnull (supplier_name, '') as vendorName, isnull (address, '') as vendorAddress, isnull (phone_number, '') as phonePerson , isnull (email, '') as vendorEmail from supplier where supplier_id = @vendorCode",
							"map": {
								"vendorName": "vendorName",
								"vendorAddress": "vendorAddress",
								"vendorGroupCode": "vendorGroupCode",
								"vendorEmail": "vendorEmail"
							}
						}
					},
					{
						"key": "vendorAddress",
						"label": "Địa chỉ Nhà cung cấp",
						"type": "text",
						"width": "150px"
					},
					{
						"key": "vendorName",
						"label": "Tên cung cấp",
						"type": "text",
						"width": "150px"
					},
					{
						"key": "vendorEmail",
						"label": "Email Nhà cung cấp",
						"type": "text",
						"width": "150px"
					},
					{
						"key": "employeeCode",
						"label": "Nhân viên",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "payTermCode",
						"label": "Kỳ hạn thanh toán",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "payTimeDays",
						"label": "TG thanh toán",
						"type": "number",
						"width": "100px",
						"required": false
					},
					{
						"key": "receivePlace",
						"label": "Nơi nhận hàng",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "receiveAddress",
						"label": "Địa chỉ nhận hàng",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú"
					},
					{
						"key": "status",
						"default": "0",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Đặt hàng",
								"value": "0"
							},
							{
								"label": "Chuyển phiếu nhập 1 phần",
								"value": "1"
							},
							{
								"label": "Đã nhập hàng",
								"value": "2"
							}
						]
					},
					{
						"key": "total_quantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_quantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_amount",
						"label": "Tổng cộng",
						"type": "number",
						"disabled": true,
						"currency": "VN",
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_amount] = SUM([amount]) ",
									"dependencies": [
										"amount"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_discount",
						"label": "Tổng chiết khấu",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_discount] = SUM([discount])",
									"dependencies": [
										"discount"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_tax",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_tax] = SUM([tax])",
									"dependencies": [
										"tax"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_payment",
						"label": "Tổng thanh toán",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[total_payment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "poindetail",
					"formId": "poindetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "40px"
						},
						{
							"key": "itemCode",
							"label": "Mã vật tư",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"itemCode",
									"uom"
								],
								"dataType": [
									"String",
									"String"
								],
								"query": "exec PoinValidItem @itemCode, @uom",
								"map": {
									"uom": "uom",
									"price": "price"
								}
							}
						},
						{
							"key": "uom",
							"label": "Đơn vị tính",
							"required": true,
							"type": "lookup",
							"width": "100px",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "quantity",
							"label": "Số lượng đặt",
							"required": true,
							"type": "number",
							"precision": 2,
							"width": "100px",
							"trigger": [
								"amount"
							]
						},
						{
							"key": "sl_gR",
							"label": "Số lượng nhập",
							"disabled": true,
							"type": "number",
							"precision": 2,
							"width": "100px"
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"width": "100px",
							"currency": "VN",
							"precision": 2,
							"trigger": [
								"amount"
							]
						},
						{
							"key": "discountRate",
							"label": "% Chiết khấu",
							"type": "number",
							"width": "100px",
							"currency": "VN",
							"trigger": [
								"amount",
								"discount",
								"payment"
							]
						},
						{
							"key": "discount",
							"label": "Chiếu khấu",
							"type": "number",
							"precision": 2,
							"width": "100px",
							"currency": "VN",
							"trigger": [
								"amount",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[discount] = [quantity] * [price] * [discountRate]/100",
										"dependencies": [
											"quantity",
											"price",
											"discountRate"
										],
										"precision": 2
									}
								]
							}
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price] + [discount]",
										"dependencies": [
											"quantity",
											"price"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "taxCode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "200px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxCode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as taxRate from tax where tax_id = @taxCode",
								"map": {
									"taxRate": "taxRate"
								}
							}
						},
						{
							"key": "taxRate",
							"label": "Thuế suất",
							"required": false,
							"width": "100px",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							]
						},
						{
							"key": "tax",
							"label": "Thuế tax",
							"type": "number",
							"currency": "VN",
							"width": "100px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[tax] = [amount] * [taxRate] / 100",
										"dependencies": [
											"amount",
											"taxRate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] + [tax] - [discount]",
										"dependencies": [
											"amount",
											"tax",
											"discount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"width": "150px",
							"type": "text",
							"uiTab": "Ghi chú"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdatePoin N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdatePoin N'@idGui', N'@voucherNumber', N'@voucherDate';"
				}
			]
		}
	}
}
