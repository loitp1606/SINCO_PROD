{
	"controller": "orderReturn",
	"type": "voucher",
	"formId": "orderReturn",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z09",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Phiếu xuất trả hàng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin phiếu xuất trả hàng",
				"class": "",
				"formId": "orderReturn",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"autoIncrement": true,
						"autoGenerate": true,
						"required": true,
						"placeholder": "Số phiếu"
					},
					{
						"key": "voucherDate",
						"label": "Ngày xuất",
						"required": true,
						"default": "now",
						"type": "date",
						"placeholder": "Chọn ngày tạo"
					},
					{
						"key": "customerGroupCode",
						"label": "Nhóm NCC",
						"type": "lookup",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "customerGroup",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "customerCode",
						"label": "Mã cung cấp",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "Supplier",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"customerCode",
								"customerGroupCode"
							],
							"dataType": [
								"String",
								"String"
							],
							"query": "select isnull (industry_group_id, '') as customerGroupCode, isnull (address, '') as addressCustomer, isnull (phone_number, '') as phoneCustomer , isnull (email, '') as emailSupplier, isnull (supplier_name, '') as invoiceCustomerCode from supplier where supplier_id = @customerCode",
							"map": {
								"addressCustomer": "addressCustomer",
								"phoneCustomer": "phoneCustomer",
								"customerGroupCode": "customerGroupCode"
							}
						}
					},
					{
						"key": "addressCustomer",
						"label": "Địa chỉ chi tiết",
						"type": "text",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "phoneCustomer",
						"label": "Điện thoại liên hệ",
						"type": "text",
						"required": true,
						"placeholder": ""
					},
					{
						"key": "employeeCode",
						"label": "Nhân viên lập phiếu",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "number_delivery",
						"label": "Số phiếu nhập hàng",
						"type": "text",
						"required": false,
						"placeholder": ""
					},	
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"uiTab": "Ghi chú",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "status",
						"label": "Trạng thái",
						"type": "select",
						"required": true,
						"options": [
							{
								"label": "Lập chứng từ",
								"value": "0"
							},
							{
								"label": "Xuất trả",
								"value": "1"
							}
						]
					},
					{
						"key": "totalQuantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalQuantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "totalAmount",
						"label": "Tổng tiền",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalAmount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "totalDiscount",
						"label": "Tổng chiết khấu",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalDiscount] = SUM([discount])",
									"dependencies": [
										"discount"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "totalTax",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalTax] = SUM([tax])",
									"dependencies": [
										"tax"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "totalPayment",
						"label": "Tổng tiền sau chiết khấu",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[totalPayment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 2
								}
							]
						}
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "orderReturnDetail",
					"formId": "orderReturnDetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "80px"
						},
						{
							"key": "item_id",
							"label": "Mã vật tư",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"item_id"
								],
								"dataType": [
									"String"
								],
								"query": "select uom from item where item_id = @item_id",
								"map": {
									"uom": "uom"
								}
							}
						},
						{
							"key": "uom",
							"label": "Đơn vị tính",
							"required": true,
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
						"key": "quantity",
						"label": "Số lượng",
						"required": true,
						"type": "number",
						"precision": 2,
						"width": "150px",
							"trigger": [
								"amount",
								"discount",
								"payment"
							]
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"width": "150px",
							"currency": "VN",
							"trigger": [
								"amount",
								"discount",
								"payment"
							]
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"width": "150px",
							"currency": "VN",
							"type": "number",
							"trigger": [
								"discount",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price]",
										"dependencies": [
											"quantity",
											"price"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "ratioDiscount",
							"label": "% Chiết khấu",
							"required": false,
							"width": "150px",
							"type": "number",
							"trigger": [
								"discount",
								"payment"
							]
						},
						{
							"key": "discount",
							"label": "Tiền chiết khấu",
							"type": "number",
							"currency": "VN",
							"width": "150px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[discount] = [amount] * [ratioDiscount] / 100",
										"dependencies": [
											"amount",
											"ratioDiscount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "taxCode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxCode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as tax_rate from tax where tax_id = @taxCode",
								"map": {
									"tax_rate": "tax_rate"
								}
							}
						},
						{
							"key": "tax_rate",
							"label": "Thuế suất",
							"required": true,
							"width": "150px",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							]
						},
						{
							"key": "tax",
							"label": "Thuế tax",
							"type": "number",
							"currency": "VN",
							"width": "150px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[tax] = ([amount] - [discount]) * [tax_rate] / 100",
										"dependencies": [
											"amount",
											"discount",
											"tax_rate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "150px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] - [discount] + [tax]",
										"dependencies": [
											"amount",
											"tax",
											"discount"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"type": "text",
							"width": "220px",
							"uiTab": "Ghi chú"
						},
						{
							"key": "siteCode",
							"label": "Kho",
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "location",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "idGuiDN",
							"label": "Id nhập hàng",
							"type": "hidden"
						},
						{
							"key": "vcNumberDN",
							"label": "Số phiếu nhập hàng",
							"type": "hidden"
						},
						{
							"key": "lnDN",
							"label": "Line nhập hàng",
							"type": "hidden"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdateOrderReturn N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdateOrderReturn N'@idGui', N'@voucherNumber', N'@voucherDate';"
				}
			]
		}
	}
}



