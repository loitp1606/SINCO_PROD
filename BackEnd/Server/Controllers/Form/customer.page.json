{
	"controller": "customer",
	"type": "list",
	"formId": "customer",
	"primaryKey": [
		"customer_id"
	],
	"idVC": "",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Khách hàng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"typeForm": "master",
				"formId": "customer",
				"primaryKey": "customer_id",
				"title": "Thông tin khách hàng",
				"fields": [
					{
						"key": "customer_id",
						"label": "Mã khách hàng",
						"type": "taxcode",
						"required": true,
						"placeholder": "Nhập mã khách hàng",
						"width": "350px"
					},
					{
						"key": "customer_name",
						"label": "Tên khách hàng",
						"type": "text",
						"required": true,
						"placeholder": "Nhập tên khách hàng",
						"width": "350px"
					},
					{
						"key": "customer_group_id",
						"label": "Nhóm / Loại khách hàng",
						"type": "lookup",
						"required": false,
						"placeholder": "Nhập nhóm hoặc loại khách hàng",
						"default": {
							"controller": "customerGroup",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"width": "350px"
					},
					{
						"key": "date_establishment",
						"label": "Ngày thành lập CTY",
						"type": "date",
						"width": "150px",
						"required": false,
						"placeholder": "Nhập thành lập"
					},
					{
						"key": "debt_limit",
						"label": "Hạn mức công nợ",
						"currency": "VN",
						"type": "number",
						"width": "100px",
						"required": false,
						"placeholder": "Nhập hạn mức"
					},
					{
						"key": "phone_number",
						"label": "Số điện thoại",
						"type": "text",
						"width": "150px",
						"placeholder": "Nhập số điện thoại",
						"required": false
					},
					{
						"key": "ma_so_thue",
						"label": "Mã số thuế",
						"type": "text",
						"required": false,
						"width": "200px"
					},
					{
						"key": "email",
						"label": "Email",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "address",
						"label": "Địa chỉ đăng ký",
						"type": "text",
						"width": "150px",
						"placeholder": "Nhập địa chỉ",
						"required": false
					},
					{
						"key": "city",
						"label": "Thành phố",
						"placeholder": "Thành phố",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "district",
						"label": "Quận/Huyện",
						"type": "text",
						"width": "150px",
						"placeholder": "Nhập Quận/Huyện",
						"required": false
					},
					{
						"key": "status",
						"default": "1",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Đang hoạt động",
								"value": "1"
							},
							{
								"label": "Bị khóa",
								"value": "0"
							}
						]
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"placeholder": "Nhập ghi chú",
						"required": false
					},
					{
						"key": "supplier_id",
						"label": "ID nhà cung cấp",
						"type": "text",
						"width": "150px",
						"placeholder": "Nhập ID NCC",
						"required": false
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết Thông tin liên hệ",
					"controllerDetail": "customerDetail",
					"formId": "customerDetail",
					"foreignKey": "customer_id",
					"fields": [
						{
							"key": "represent_name",
							"label": "Người đại diện",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "represent_role",
							"label": "Chức vụ người DD",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "represent_birthday",
							"label": "Ngày sinh người đại diện",
							"type": "date",
							"width": "150px"
						},
						{
							"key": "name",
							"label": "Tên người liên hệ",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "role",
							"label": "Chức vụ",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "phone_number",
							"label": "Số điện thoại",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "email",
							"label": "Email",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "address",
							"label": "Địa chỉ liên hệ",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"type": "text",
							"width": "150px",
							"uiTab": "Ghi chú"
						}
					]
				},
				{
					"title": "Chi tiết Thông tin giao hàng",
					"controllerDetail": "deliveryDetail",
					"formId": "deliveryDetail",
					"foreignKey": "customer_id,delivery_id",
					"fields": [
						{
							"key": "delivery_id",
							"label": "Thông tin giao hàng",
							"type": "lookup",
							"width": "150px",
							"default": {
								"controller": "deliveryLocation",
								"filter": []
							}
						},
						{
							"key": "role",
							"label": "Người liên hệ giao hàng",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "address",
							"label": "Địa chỉ giao hàng",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "phone_number",
							"label": "Số điện thoại giao hàng",
							"type": "text",
							"width": "150px"
						},
						{
							"key": "note",
							"label": "Ghi chú giao hàng",
							"type": "text",
							"width": "150px",
							"uiTab": "Ghi chú"
						}
					]
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "update customer set statusname = case when status = '1' then  N'Đang hoạt động' else N'Bị khóa' end where customer_id = N'@customer_id';exec syncCustomer N'@customer_id';"
				}
			]
		}
	}
}