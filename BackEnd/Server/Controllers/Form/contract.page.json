{
	"controller": "contract",
	"type": "voucher",
	"formId": "contract",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z04",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Hợp đồng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin hợp đồng",
				"class": "",
				"formId": "Contract",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherDate",
						"label": "Ngày tạo",
						"type": "date",
						"default": "now",
						"required": false,
						"placeholder": "",
						"width": "100px"
					},
					{
						"key": "voucherNumber",
						"label": "Số hợp đồng",
						"type": "text",
						"autoIncrement": true,
						"required": true,
						"placeholder": "Số phiếu",
						"autoGenerate": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "customer_id",
						"label": "Mã khách hàng",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "customer",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"customerCode"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull (a.address, '') as address, isnull (a.phone_number, '') as phone , isnull (a.ma_so_thue, '') as tax_code, isnull (a.email, '') as email, isnull (a.customer_group_id, '') as customer_group_id, isnull(b.represent_name, '') representative, isnull(b.represent_role, '') position from customer a left join customerDetail b on a.customer_id = b.customer_id and b.line_nbr = 1 where a.customer_id = @customerCode",
							"map": {
								"address": "address",
								"phone": "phone",
								"customer_group_id": "customer_group_id",
								"email": "email",
								"representative": "representative",
								"position": "position",
								"tax_code":"tax_code"
							}
						},
						"width": "350px"
					},
					{
						"key": "number_ddh",
						"label": "Số ĐĐH",
						"required": false,
						"type": "text",
						"width": "150px",
						"placeholder": ""
					},
					{
						"key": "quotationCode",
						"label": "Mã báo giá",
						"required": false,
						"type": "text",
						"width": "150px",
						"placeholder": ""
					},
					{
						"key": "customer_group_id",
						"label": "Nhóm khách hàng",
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "CustomerGroup",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"width": "350px"
					},
					{
						"key": "representative",
						"label": "Đại diện Ký hợp hợp đồng",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "position",
						"label": "Chức vụ",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "address",
						"label": "Địa chỉ",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "phone",
						"label": "Điện thoại",
						"type": "text",
						"width": "150px",
						"placeholder": ""
					},
					{
						"key": "account",
						"label": "Tài khoản",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "customer_account",
						"label": "Tài khoản (Bên B)",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "dai_dien_cty",
						"label": "Đại diện Sinco",
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								},
								{
									"field": "daidien_yn",
									"value": "1",
									"operator": "="
								}
							]
						},
						"width": "350px"
					},
					{
						"key": "tax_code",
						"label": "MST",
						"type": "text",
						"required": false,
						"placeholder": "",
						"width": "200px"
					},
					{
						"key": "SaleID",
						"label": "Mã NVKD",
						"required": false,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "delivery_note",
						"label": "Ghi chú Thời gian giao nhận hàng",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "contract_note",
						"label": "Ghi chú Hiệu lực hợp đồng",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "status",
						"default": "0",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Lập chứng từ",
								"value": "0"
							},
							{
								"label": "Tạo hợp đồng",
								"value": "1"
							}
						]
					},
					{
						"key": "isReceived",
						"label": "Đã nhận",
						"type": "checkbox",
						"width": "150px"
					},
					{
						"key": "total_quantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_quantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "amount_total",
						"label": "Tổng cộng",
						"type": "number",
						"disabled": true,
						"currency": "VN",
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[amount_total] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_vat",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_vat] = SUM([tax])",
									"dependencies": [
										"vat"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "total_payment",
						"label": "Tổng tiền sau thuế",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[total_payment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 0
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "amount_in_word",
						"label": "Số tiền bằng chữ",
						"type": "text",
						"width": "150px",
						"amountInWordSource": "total_payment",
						"subtotal": true,
						"disabled": true,
						"required": false,
						"placeholder": ""
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "contractDetail",
					"formId": "contractDetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "40px"
						},
						{
							"key": "item_id",
							"label": "Mã hàng",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"item_id"
								],
								"dataType": [
									"String"
								],
								"query": "select uom as uomCode from item where item_id = @item_id",
								"map": {
									"uomCode": "uomCode"
								}
							}
						},
						{
							"key": "uomCode",
							"label": "Đơn vị tính",
							"required": true,
							"width": "100px",
							"type": "lookup",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "quantity",
							"label": "Số lượng",
							"width": "100px",
							"type": "number",
							"precision": 2,
							"trigger": [
								"amount"
							]
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"width": "100px",
							"currency": "VN",
							"precision": 2,
							"trigger": [
								"amount"
							]
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"currency": "VN",
							"width": "100px",
							"type": "number",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price]",
										"dependencies": [
											"quantity",
											"price"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "taxcode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "200px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxcode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as tax_rate from tax where tax_id = @taxcode",
								"map": {
									"tax_rate": "tax_rate"
								}
							}
						},
						{
							"key": "tax_rate",
							"label": "Thuế suất",
							"required": true,
							"width": "100px",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							]
						},
						{
							"key": "tax",
							"label": "VAT",
							"type": "number",
							"currency": "VN",
							"width": "100px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[tax] = [amount] * [tax_rate] / 100",
										"dependencies": [
											"amount",
											"tax_rate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] + [tax]",
										"dependencies": [
											"amount",
											"tax"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "note",
							"width": "150px",
							"label": "Ghi chú",
							"type": "textarea",
							"uiTab": "Ghi chú"
						}
					],
					"initialData": []
				}
			]
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdateContract N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdateContract N'@idGui', N'@voucherNumber', N'@voucherDate';"
				}
			]
		}
	}
}
