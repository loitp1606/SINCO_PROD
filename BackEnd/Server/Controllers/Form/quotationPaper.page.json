{
	"controller": "QuotationPaper",
	"type": "voucher",
	"formId": "QuotationPaper",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z02",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Báo giá",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin báo giá",
				"class": "",
				"formId": "QuotationPaper",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "customerCode",
						"label": "Mã khách hàng",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "customer",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"customerCode",
								"note"
							],
							"dataType": [
								"String",
								"String"
							],
							"query": "exec QuotationPaperValidCustomer @customerCode, @note",
							"map": {
								"contactPerson": "contactPerson",
								"orderAddress": "orderAddress",
								"phonePerson": "phonePerson",
								"emailPerson": "emailPerson",
								"note": "note"
							}
						}
					},
					{
						"key": "jobCode",
						"label": "Dự án",
						"required": false,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "job",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "voucherDate",
						"label": "Ngày báo giá",
						"required": true,
						"type": "date",
						"default": "now",
						"placeholder": "Chọn ngày báo giá"
					},
					{
						"key": "voucherNumber",
						"label": "Số báo giá",
						"type": "text",
						"autoIncrement": true,
						"required": true,
						"placeholder": "Số báo giá",
						"autoGenerate": true,
						"readonly": true
					},
					{
						"key": "employee_id",
						"label": "Mã nhân viên",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"employee_id"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull (full_name, '') as employeeName, isnull (phone_number, '') as phone , isnull (email, '') as email from employee where employee_id = @employee_id",
							"map": {
								"employeeName": "employeeName",
								"phone": "phone",
								"email": "email"
							}
						}
					},
					{
						"key": "employeeName",
						"label": "Tên nhân viên",
						"type": "text",
						"required": true,
						"placeholder": "Nhập tên nhân viên"
					},
					{
						"key": "contactPerson",
						"label": "Người liên hệ báo giá",
						"type": "text",
						"required": true,
						"placeholder": ""
					},
					{
						"key": "phonePerson",
						"label": "Điện thoại",
						"type": "text",
						"required": true,
						"placeholder": ""
					},
					{
						"key": "orderAddress",
						"label": "Địa chỉ",
						"type": "text",
						"required": true,
						"placeholder": ""
					},
					{
						"key": "emailPerson",
						"label": "Email",
						"type": "text",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "phone",
						"label": "Điện thoại nhân viên",
						"type": "text",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "fax",
						"label": "Fax",
						"type": "text",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "email",
						"label": "Email nhân viên",
						"type": "text",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "status",
						"label": "Trạng thái",
						"type": "select",
						"required": true,
						"default": "0",
						"options": [
							{
								"label": "Đang báo giá",
								"value": "0"
							},
							{
								"label": "Báo giá thành công",
								"value": "1"
							}
						]
					},
		
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"uiTab": "Ghi chú",
						"required": false,
						"maxLength": 1000,
						"default": "Đơn giá chưa bao gồm: chi phí thí nghiệm vật tư, MBA, bánh xe MBA\n- Thời gian giao hàng : Trong vòng .... ngày làm việc kể từ ngày tạm ứng\n- Địa điểm giao hàng : giao hàng tại ... phần xuống hàng thuộc phạm vi Bên Mua\n- Hình thức thanh toán : Bằng chuyển khoản theo hai đợt\n+ Đợt 1: Bên Mua tạm ứng 30% giá trị đơn hàng để xác nhận đặt hàng\n+ Đợt 2: Bên Mua thanh toán 70% giá trị còn lại trước khi nhận hàng\n- Hiệu lực báo giá : Trong vòng 03 ngày.\n- Số TK : 12913269 - NH ACB HỘI SỞ TP.HCM.\n\nCÔNG TY TNHH TM & XL CÔNG NGHIỆP SÀI GÒN\nRất mong nhận được thông tin từ Quý công ty"
					},
					{
						"key": "total_quantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_quantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "total_amount",
						"label": "Tổng tiền",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_amount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "total_vat",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_vat] = SUM([vat])",
									"dependencies": [
										"vat"
									],
									"precision": 2
								}
							]
						}
					},
					{
						"key": "total_payment",
						"label": "Tổng tiền sau thuế",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[total_payment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 2
								}
							]
						}
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "QuotationPaperDetail",
					"formId": "QuotationPaperDetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "80px"
						},
						{
							"key": "itemNameCustomer",
							"label": "Tên Vật tư KH",
							"type": "text",
							"width": "250px"
						},
						{
							"key": "nha_san_xuat",
							"label": "Nhà sản xuất",
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "manufacturer",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "itemCode",
							"label": "Mã vật tư",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"itemCode",
									"uom",
									"itemNameCustomer"
								],
								"dataType": [
									"String",
									"String",
									"String"
								],
								"query": "exec QuotationPaperValidItem @itemCode, @itemNameCustomer, @uom",
								"map": {
									"uom": "uom",
									"nha_san_xuat": "nha_san_xuat",
									"price": "price",
									"purchasePrice": "purchasePrice",
									"itemNameCustomer": "itemNameCustomer"
								}
							}
						},
						{
							"key": "uom",
							"label": "Đơn vị tính",
							"required": true,
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "quantity",
							"label": "Số lượng",
							"required": true,
							"type": "number",
							"precision": 2,
							"width": "150px",
							"trigger": [
								"amount",
								"vat",
								"payment"
							]
						},
						{
							"key": "sl_order",
							"label": "Số lượng ĐH",
							"disabled": true,
							"type": "number",
							"precision": 2,
							"width": "150px"
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"currency": "VN",
							"width": "150px",
							"precision": 2,
							"trigger": [
								"price2",
								"amount",
								"vat",
								"payment"
							]
						},
						{
							"key": "ratioDiscount",
							"label": "% Chiết khấu",
							"required": false,
							"width": "150px",
							"type": "number",
							"trigger": [
								"price2",
								"amount",
								"vat",
								"payment"
							]
						},
						{
							"key": "price2",
							"label": "Đơn giá CK",
							"type": "number",
							"width": "150px",
							"currency": "VN",
							"precision": 2,
							"trigger": [
								"amount",
								"vat",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[price2] = ([price] * (1-([ratioDiscount] / 100)))",
										"dependencies": [
											"price",
											"ratioDiscount"
										],
										"precision": 2
									}
								]
							}
						},
						{
							"key": "purchasePrice",
							"label": "Giá mua",
							"currency": "VN",
							"width": "150px",
							"precision": 2,
							"type": "number"
						},
						{
							"key": "price_differ",
							"label": "Chênh lệch bán mua",
							"currency": "VN",
							"width": "150px",
							"precision": 2,
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[price_differ] = ([price2] - [purchasePrice])",
										"dependencies": [
											"price2",
											"purchasePrice"
										],
										"precision": 2
									}
								]
							}
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"width": "150px",
							"currency": "VN",
							"type": "number",
							"trigger": [
								"vat",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price2]",
										"dependencies": [
											"quantity",
											"price2"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "taxCode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "150px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxCode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as tax_rate from tax where tax_id = @taxCode",
								"map": {
									"tax_rate": "tax_rate"
								}
							}
						},
						{
							"key": "tax_rate",
							"label": "Thuế suất",
							"required": false,
							"width": "150px",
							"type": "number",
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"tax_rate"
								],
								"dataType": [
									"Int"
								],
								"query": "select tax_id as taxCode from tax where tax_number = @tax_rate",
								"map": {
									"taxCode": "taxCode"
								}
							},
							"trigger": [
								"vat",
								"payment"
							]
						},
						{
							"key": "vat",
							"label": "Thuế VAT",
							"type": "number",
							"currency": "VN",
							"width": "150px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[vat] = [amount] * [tax_rate] / 100",
										"dependencies": [
											"amount",
											"tax_rate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "150px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] + [vat]",
										"dependencies": [
											"amount",
											"vat"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"width": "150px",
							"type": "text",
							"uiTab": "Ghi chú"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdateBaoGia N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdateBaoGia N'@idGui', N'@voucherNumber', N'@voucherDate';"
				}
			]
		}
	},
	"popupActions": [
		{
			"id": "customerDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ khách hàng",
				"depositField": "depositAmount",
				"receivableField": "receivableAmount",
				"payableField": "collectedAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetCustomerDebtSummary @customerCode, @unitCode",
					"params": [
						"customerCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@customerCode",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "receivableAmount",
						"payable": "collectedAmount"
					}
				}
			}
		}
	]
}


