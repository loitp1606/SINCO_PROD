{
	"controller": "receiptV2",
	"type": "voucher",
	"formId": "receiptV2",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z07",
	"VCDate": "voucherDate",
	"title": "Phiếu thu tiền",
	"tabs": [
		{
			"title": "Phiếu thu tiền",
			"form": {
				"title": "Thông tin phiếu thu",
				"formId": "receiptV2",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"type": "text",
						"required": true,
						"autoIncrement": true,
						"autoGenerate": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "voucherDate",
						"label": "Ngày",
						"type": "date",
						"required": true,
						"default": "now",
						"width": "100px"
					},
					{
						"key": "receiptType",
						"label": "Loại thu",
						"type": "select",
						"width": "150px",
						"required": true,
						"default": "DEPOSIT",
						"quickEditable": true,
						"options": [
							{
								"label": "Thu tiền đặt cọc",
								"value": "DEPOSIT"
							},
							{
								"label": "Thu công nợ trực tiếp",
								"value": "CUSTOMER"
							},
							{
								"label": "Thu công nợ từ tiền đặt cọc",
								"value": "DEPOSIT_OFFSET"
							},
							{
								"label": "Thu khác",
								"value": "OTHER"
							}
						]
					},
					{
						"key": "customerCode",
						"label": "Khách hàng",
						"type": "lookup",
						"required": true,
						"width": "350px",
						"multiple": false,
						"default": {
							"controller": "customer",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"customerCode"
							],
							"dataType": [
								"String"
							],
							"query": "select isnull(address,'') as customerAddress from customer where customer_id = @customerCode",
							"map": {
								"customerAddress": "customerAddress"
							}
						}
					},
					{
						"key": "deliveryNoteNo",
						"label": "Mã tham chiếu",
						"type": "hidden",
						"width": "150px",
						"required": false
					},
					{
						"key": "allocationJson",
						"label": "Dữ liệu phân bổ công nợ",
						"type": "hidden",
						"required": false
					},
					{
						"key": "depositAmount",
						"label": "Tiền đặt cọc hiện có",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"readonly": true,
						"transient": true,
						"width": "150px",
						"required": false,
						"visibleWhen": {
							"field": "receiptType",
							"operator": "=",
							"value": "DEPOSIT_OFFSET"
						}
					},
					{
						"key": "depositReceiptNo",
						"label": "Phiếu thu cọc tham chiếu",
						"type": "hidden",
						"width": "150px",
						"required": false,
						"visibleWhen": {
							"field": "receiptType",
							"operator": "=",
							"value": "DEPOSIT_OFFSET"
						}
					},
					{
						"key": "reason",
						"label": "Lý do thu",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "Incomeexpenditure",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								},
								{
									"field": "type",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "customerAddress",
						"label": "Địa chỉ - Điện thoại",
						"type": "text",
						"width": "150px",
						"required": false
					},
					{
						"key": "collectorCode",
						"label": "Nhân viên thu",
						"type": "lookup",
						"width": "150px",
						"required": true,
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "accountReceiveCode",
						"label": "Số tài khoản (*)",
						"type": "lookup",
						"width": "150px",
						"required": false,
						"multiple": false,
						"default": {
							"controller": "AccountSinco",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "invoiceNumber",
						"label": "Số hoá đơn thu",
						"type": "hidden",
						"width": "150px",
						"required": false
					},
					{
						"key": "paymentType",
						"label": "Loại thanh toán",
						"type": "select",
						"width": "150px",
						"default":"CK",
						"required": true,
						"options": [
							{
								"label": "Tiền mặt",
								"value": "TM"
							},
							{
								"label": "Chuyển khoản",
								"value": "CK"
							}
						]
					},
					{
						"key": "dien_giai",
						"label": "Diễn giải",
						"type": "textarea",
						"width": "150px",
						"required": false,
						"placeholder": "Nhập diễn giải"
					},
					{
						"key": "isReceived",
						"label": "Đã thu",
						"type": "checkbox",
						"width": "100px"
					},
					{
						"key": "total_amount",
						"label": "Số tiền thu (*)",
						"type": "number",
						"currency": "VN",
						"disabled": false,
						"width": "100px",
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[total_amount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 0
								}
							]
						}
					},
					{
						"key": "status",
						"label": "Trạng thái",
						"type": "hidden",
						"width": "150px",
						"default":"1",
						"required": false,
						"options": [
							{
								"label": "Tạo phiếu",
								"value": "0"
							},
							{
								"label": "Xác nhận",
								"value": "1"
							}
						]
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"required": false
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Danh sách phiếu xuất còn nợ",
					"controllerDetail": "receiptdetailV2",
					"formId": "receiptdetailV2",
					"foreignKey": "idGui,line_nbr",
					"allowAdd": false,
					"allowDelete": false,
					"allowMove": false,
					"allowSelect": false,
					"visibleWhen": {
						"field": "receiptType",
						"operator": "in",
						"value": [
							"CUSTOMER",
							"DEPOSIT_OFFSET"
						]
					},
					"autoLoad": {
						"whenFieldsChange": [
							"receiptType",
							"customerCode"
						],
						"clearWhenEmpty": true,
						"dataSource": {
							"api": "/api/CustomQuery/execute",
							"query": "exec dbo.sp_GetCustomerReceiptAllocation @mode, @idGui, @customerCode, @unitCode, @keyword",
							"params": [
								"mode",
								"idGui",
								"customerCode",
								"unitCode",
								"keyword"
							],
							"dataType": [
								"String",
								"String",
								"String",
								"String",
								"String"
							],
							"values": [
								"EDIT",
								"@idGui",
								"@customerCode",
								"@unitCode",
								""
							]
						},
						"map": {
							"idGuiDN": "refIdGuiDN",
							"lnDN": "refLineNbrDN",
							"vcNumberDN": "voucherNumber",
							"invoiceNumber": "voucherNumber",
							"invoiceDate": "voucherDate",
							"invoiceAmount": "receivableAmount",
							"paidAmount": "collectedAmount",
							"debtAmount": "outstandingAmount",
							"amount": "allocatedAmount",
							"note": "note"
						}
					},
					"allocationJson": {
						"enabled": true,
						"allocationJsonField": "allocationJson",
						"receiptAmountField": "total_amount",
						"receiptTypeField": "receiptType",
						"lineNbrField": "line_nbr",
						"refIdGuiField": "idGuiDN",
						"refLineNbrField": "lnDN",
						"voucherNumberField": "vcNumberDN",
						"invoiceDateField": "invoiceDate",
						"invoiceAmountField": "invoiceAmount",
						"outstandingAmountField": "debtAmount",
						"allocatedAmountField": "amount",
						"noteField": "note"
					},
					"autoAllocate": {
						"enabled": true,
						"label": "Phân bổ tự động",
						"clearLabel": "Xóa phân bổ",
						"receiptTypes": [
							"DEPOSIT_OFFSET"
						],
						"sourceAmountField": "depositAmount",
						"targetTotalField": "total_amount",
						"outstandingAmountField": "debtAmount",
						"allocatedAmountField": "amount"
					},
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"type": "text",
							"disabled": true,
							"width": "60px"
						},
						{
							"key": "vcNumberDN",
							"label": "Số phiếu xuất",
							"type": "text",
							"disabled": true,
							"required": true,
							"width": "160px"
						},
						{
							"key": "invoiceDate",
							"label": "Ngày xuất",
							"type": "date",
							"disabled": true,
							"width": "120px"
						},
						{
							"key": "invoiceAmount",
							"label": "Tiền phiếu xuất",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"width": "150px"
						},
						{
							"key": "paidAmount",
							"label": "Đã thu",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"width": "140px"
						},
						{
							"key": "debtAmount",
							"label": "Còn phải thu",
							"type": "number",
							"currency": "VN",
							"disabled": true,
							"width": "150px"
						},
						{
							"key": "amount",
							"label": "Số tiền thu",
							"type": "number",
							"currency": "VN",
							"required": true,
							"width": "150px"
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"type": "text",
							"width": "220px"
						},
						{
							"key": "idGuiDN",
							"label": "Key phiếu xuất",
							"type": "hidden"
						},
						{
							"key": "lnDN",
							"label": "Dòng phiếu xuất",
							"type": "hidden"
						},
						{
							"key": "invoiceNumber",
							"label": "Số hóa đơn",
							"type": "hidden"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "EXEC dbo.sp_PostDebtFromReceiptV2 N'@idGui', '@unit', '@userId';IF UPPER(N'@receiptType') IN (N'CUSTOMER', N'DEPOSIT_OFFSET') EXEC dbo.sp_SaveCustomerReceiptAllocation N'@idGui', N'@allocationJson', '@unit', '@userId';IF UPPER(N'@receiptType') IN (N'CUSTOMER', N'DEPOSIT_OFFSET') EXEC dbo.sp_ApplyCustomerReceiptAllocationFromReceiptV2 N'@idGui', '@unit', '@userId';"
				}
			]
		}
	},
	"popupActions": [
		{
			"id": "customerDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ khách hàng",
				"depositLabel": "Đã cọc",
				"receivableLabel": "Phải thu",
				"payableLabel": "Đã thu",
				"depositField": "depositAmount",
				"receivableField": "receivableAmount",
				"payableField": "collectedAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetCustomerDebtSummary @customerCode, @unitCode",
					"params": [
						"customerCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@customerCode",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "receivableAmount",
						"payable": "collectedAmount"
					}
				}
			}
		}
	]
}
