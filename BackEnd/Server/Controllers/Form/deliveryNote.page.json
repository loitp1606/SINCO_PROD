{
	"controller": "deliveryNote",
	"type": "voucher",
	"formId": "deliveryNote",
	"primaryKey": [
		"idGui"
	],
	"idVC": "Z05",
	"VCDate": "",
	"title": "",
	"class": "onSelectChange()",
	"tabs": [
		{
			"title": "Phiếu xuất hàng",
			"class": "text-[48px] px-4 py-2 focus:outline-none",
			"form": {
				"title": "Thông tin phiếu xuất hàng",
				"class": "",
				"formId": "deliveryNote",
				"fields": [
					{
						"key": "idGui",
						"label": "Key",
						"type": "hidden"
					},
					{
						"key": "voucherDate",
						"label": "Ngày tạo",
						"required": true,
						"default": "now",
						"type": "date",
						"placeholder": "Chọn ngày tạo",
						"width": "100px"
					},
					{
						"key": "voucherNumber",
						"label": "Số phiếu",
						"autoGenerate": true,
						"type": "text",
						"required": true,
						"placeholder": "Số phiếu xuất",
						"autoIncrement": true,
						"readonly": true,
						"width": "100px"
					},
					{
						"key": "number_ddh",
						"label": "Số ĐĐH",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "number_quotation",
						"label": "Số báo giá",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "number_contract",
						"label": "Số hợp đồng",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "jobCode",
						"label": "Dự án",
						"required": false,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "job",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "deliveryDate",
						"label": "Ngày giao",
						"required": false,
						"type": "date",
						"width": "150px",
						"placeholder": ""
					},
					{
						"key": "appointmentDate",
						"label": "Ngày hẹn thanh toán",
						"required": false,
						"type": "date",
						"width": "150px",
						"placeholder": ""
					},
					{
						"key": "customer_id",
						"label": "Mã khách hàng",
						"required": true,
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "customer",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"customer_id"
							],
							"dataType": [
								"String"
							],
							"query": "select address as orderAddress, customer_id as customerVAT from customer where customer_id = @customer_id",
							"map": {
								"orderAddress": "orderAddress",
								"customerVAT": "customerVAT"
							}
						},
						"width": "350px"
					},
					{
						"key": "customerVAT",
						"label": "Khách hàng VAT",
						"type": "lookup",
						"multiple": false,
						"default": {
							"controller": "customer",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"width": "350px"
					},
					{
						"key": "contactPerson",
						"label": "Người liên hệ giao hàng",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "phonePerson",
						"label": "Điện thoại",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "orderAddress",
						"label": "Địa chỉ",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "emailPerson",
						"label": "Email",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "employee_id",
						"label": "Nhân viên KD",
						"required": true,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "Employee",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						}
					},
					{
						"key": "phonePersonCreate",
						"label": "Điện thoại người tạo",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "faxPersonCreate",
						"label": "Số Fax",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "mailFrom",
						"label": "Mail (Người gửi)",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "term",
						"label": "Kỳ hạn thanh toán",
						"type": "number",
						"width": "100px",
						"placeholder": ""
					},
					{
						"key": "amoutFare",
						"label": "Tiền cước",
						"type": "number",
						"width": "100px",
						"currency": "VN",
						"placeholder": ""
					},
					{
						"key": "truck_id",
						"label": "Chành xe",
						"required": false,
						"type": "lookup",
						"width": "150px",
						"multiple": false,
						"default": {
							"controller": "DeliveryLocation",
							"filter": [
								{
									"field": "status",
									"value": "1",
									"operator": "="
								}
							]
						},
						"onChange": {
							"api": "/api/CustomQuery/execute",
							"params": [
								"truck_id"
							],
							"dataType": [
								"String"
							],
							"query": "select address as addresstruck from deliveryLocation where delivery_id = @truck_id",
							"map": {
								"addresstruck": "addresstruck"
							}
						}
					},
					{
						"key": "addresstruck",
						"label": "Địa chỉ chành",
						"type": "text",
						"width": "150px",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "note",
						"label": "Ghi chú",
						"type": "textarea",
						"width": "150px",
						"uiTab": "Ghi chú",
						"required": false,
						"placeholder": ""
					},
					{
						"key": "status",
						"default": "0",
						"label": "Trạng thái",
						"type": "select",
						"width": "150px",
						"required": true,
						"options": [
							{
								"label": "Đang chờ giao",
								"value": "0"
							},
							{
								"label": "Đã giao hàng",
								"value": "1"
							}
						]
					},
					{
						"key": "paymentStatus",
						"label": "TT thanh toán",
						"type": "select",
						"width": "150px",
						"required": false,
						"options": [
							{
								"label": "Chưa thu",
								"value": "UNPAID"
							},
							{
								"label": "Thu một phần",
								"value": "PARTIAL"
							},
							{
								"label": "Đã thu đủ",
								"value": "PAID"
							},
							{
								"label": "Quá hạn",
								"value": "OVERDUE"
							}
						]
					},
					{
						"key": "paidAmount",
						"label": "Đã thu",
						"type": "number",
						"currency": "VN",
						"required": false,
						"width": "100px"
					},
					{
						"key": "debtAmount",
						"label": "Còn nợ",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[debtAmount] = [totalPayment] - [paidAmount]",
									"dependencies": [
										"totalPayment",
										"paidAmount"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "deliveryStatus",
						"label": "TT giao hàng",
						"type": "hidden"
					},
					{
						"key": "signReceiptStatus",
						"label": "TT ký nhận",
						"type": "select",
						"width": "150px",
						"required": false,
						"options": [
							{
								"label": "Chưa nhận ký",
								"value": "PENDING"
							},
							{
								"label": "Đã nhận ký",
								"value": "RECEIVED"
							},
							{
								"label": "Thiếu chứng từ",
								"value": "MISSING"
							}
						]
					},
					{
						"key": "receiptCount",
						"label": "Số phiếu thu",
						"type": "number",
						"width": "100px",
						"disabled": true
					},
					{
						"key": "isOverdue",
						"label": "Quá hạn",
						"type": "select",
						"width": "150px",
						"required": false,
						"options": [
							{
								"label": "Không",
								"value": "0"
							},
							{
								"label": "Có",
								"value": "1"
							}
						]
					},
					{
						"key": "overdueDays",
						"label": "Số ngày quá hạn",
						"type": "number",
						"width": "100px"
					},
					{
						"key": "totalQuantity",
						"label": "Tổng số lượng",
						"type": "number",
						"precision": 2,
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalQuantity] = SUM([quantity])",
									"dependencies": [
										"quantity"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalAmount",
						"label": "Tổng tiền",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalAmount] = SUM([amount])",
									"dependencies": [
										"amount"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalTax",
						"label": "Tổng thuế",
						"type": "number",
						"currency": "VN",
						"disabled": true,
						"subtotal": true,
						"calculation": {
							"calculations": [
								{
									"formula": "[totalTax] = SUM([tax])",
									"dependencies": [
										"tax"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					},
					{
						"key": "totalPayment",
						"label": "Tổng tiền sau thuế",
						"type": "number",
						"disabled": true,
						"subtotal": true,
						"currency": "VN",
						"calculation": {
							"calculations": [
								{
									"formula": "[totalPayment] = SUM([payment])",
									"dependencies": [
										"payment"
									],
									"precision": 2
								}
							]
						},
						"width": "100px"
					}
				],
				"initialData": {}
			},
			"detail": [
				{
					"title": "Chi tiết",
					"controllerDetail": "deliveryNoteDetail",
					"formId": "deliveryNoteDetail",
					"foreignKey": "idGui, line_nbr",
					"fields": [
						{
							"key": "line_nbr",
							"label": "Stt",
							"disabled": true,
							"type": "text",
							"width": "40px"
						},
						{
							"key": "item_id",
							"label": "Mã vật tư",
							"required": true,
							"type": "lookup",
							"width": "450px",
							"multiple": false,
							"default": {
								"controller": "item",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"item_id"
								],
								"dataType": [
									"String"
								],
								"query": "select uom, uom as uomCustomer,  item_name as itemNameCustomer from item where item_id = @item_id",
								"map": {
									"uom": "uom",
									"uomCustomer": "uomCustomer",
									"itemNameCustomer": "itemNameCustomer"
								}
							}
						},
						{
							"key": "uom",
							"label": "Đơn vị tính",
							"required": true,
							"type": "lookup",
							"width": "100px",
							"multiple": false,
							"default": {
								"controller": "uom",
								"filter": [
									{
										"field": "status",
										"value": "1",
										"operator": "="
									}
								]
							}
						},
						{
							"key": "quantity",
							"label": "Số lượng",
							"required": true,
							"type": "number",
							"precision": 2,
							"width": "100px",
							"trigger": [
								"amount",
								"tax",
								"payment"
							]
						},
						{
							"key": "price",
							"label": "Đơn giá",
							"type": "number",
							"width": "100px",
							"currency": "VN",
							"precision": 2,
							"trigger": [
								"amount",
								"tax",
								"payment"
							]
						},
						{
							"key": "purchasePrice",
							"label": "Giá mua",
							"currency": "VN",
							"width": "100px",
							"precision": 2,
							"type": "number"
						},
						{
							"key": "amount",
							"label": "Thành tiền",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[amount] = [quantity] * [price]",
										"dependencies": [
											"quantity",
											"price"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "taxCode",
							"label": "Mã thuế",
							"required": true,
							"type": "lookup",
							"width": "200px",
							"multiple": false,
							"default": {
								"controller": "tax",
								"filter": [
									{
										"field": "1",
										"value": "1",
										"operator": "="
									}
								]
							},
							"onChange": {
								"api": "/api/CustomQuery/execute",
								"params": [
									"taxCode"
								],
								"dataType": [
									"String"
								],
								"query": "select tax_number as tax_rate from tax where tax_id = @taxCode",
								"map": {
									"tax_rate": "tax_rate"
								}
							}
						},
						{
							"key": "tax_rate",
							"label": "Thuế suất",
							"required": true,
							"width": "100px",
							"type": "number",
							"trigger": [
								"tax",
								"payment"
							]
						},
						{
							"key": "tax",
							"label": "Thuế tax",
							"type": "number",
							"currency": "VN",
							"width": "100px",
							"trigger": [
								"payment"
							],
							"calculation": {
								"calculations": [
									{
										"formula": "[tax] = [amount] * [tax_rate] / 100",
										"dependencies": [
											"amount",
											"tax_rate"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "payment",
							"label": "Tổng cộng",
							"width": "100px",
							"currency": "VN",
							"type": "number",
							"calculation": {
								"calculations": [
									{
										"formula": "[payment] = [amount] + [tax]",
										"dependencies": [
											"amount",
											"tax"
										],
										"precision": 0
									}
								]
							}
						},
						{
							"key": "itemNameCustomer",
							"label": "Tên Vật tư KH",
							"type": "text",
							"width": "450px"
						},
						{
							"key": "invoiceNumber",
							"label": "Số hóa đơn",
							"type": "text",
							"quickEditable": true,
							"width": "150px"
						},
						{
							"key": "invoiceDate",
							"label": "Ngày hóa đơn",
							"type": "date",
							"quickEditable": true,
							"width": "150px"
						},
						{
							"key": "isReceived",
							"label": "Đã nhận",
							"type": "checkbox",
							"quickEditable": true,
							"width": "100px"
						},
						{
							"key": "note",
							"label": "Ghi chú",
							"type": "text",
							"width": "250px"
						}
					],
					"initialData": []
				}
			]
		},
		{
			"title": "Tệp đính kèm",
			"type": "file-attachment"
		}
	],
	"dataProcessing": {
		"actions": {
			"post": [
				{
					"step": "beforeUpdate",
					"type": "sql01",
					"query": "exec beforeUpdateDeliveryNote N'@idGui', N'@voucherNumber', N'@voucherDate';exec beforeUpdateDeliveryNote2 N'@idGui', N'@voucherNumber', N'@voucherDate';"
				},
				{
					"step": "afterUpdate",
					"type": "sql02",
					"query": "exec afterUpdateDeliveyNote N'@idGui', N'@voucherNumber', N'@voucherDate';exec afterUpdateDeliveyNote2 N'@idGui', N'@voucherNumber', N'@voucherDate';exec dbo.sp_PostDebtFromDeliveryNote N'@idGui', N'@unit', N'@userId';"
				}
			]
		}
	},
	"popupActions": [
		{
			"id": "customerDebt",
			"label": "Xem công nợ",
			"type": "customerDebt",
			"style": "info",
			"showInView": true,
			"config": {
				"title": "Công nợ khách hàng",
				"depositField": "depositAmount",
				"receivableField": "receivableAmount",
				"payableField": "collectedAmount",
				"dataSource": {
					"api": "/api/CustomQuery/execute",
					"query": "exec sp_GetCustomerDebtSummary @customerCode, @unitCode",
					"params": [
						"customerCode",
						"unitCode"
					],
					"dataType": [
						"String",
						"String"
					],
					"values": [
						"@customer_id",
						"@unit"
					],
					"map": {
						"deposit": "depositAmount",
						"receivable": "receivableAmount",
						"payable": "collectedAmount"
					}
				}
			}
		}
	]
}
