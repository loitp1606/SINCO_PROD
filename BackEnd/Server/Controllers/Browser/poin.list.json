      "label": "Ngày tạo",
      "type": "date"
    },
    {
      "key": "voucherNumber",
      "label": "Số phiếu",
      "type": "text"
    },
    {
      "key": "vendorCode",
      "label": "Mã NCC",
      "type": "lookup"
    },
    {
      "key": "status",
      "label": "Trạng thái",
      "type": "select",
      "options": [
        {
          "label": "Lập chứng từ",
          "value": "0"
        },
        {
          "label": "Đặt hàng",
          "value": "1"
        }
      ]
    },
    {
      "key": "note",
      "label": "Ghi chú",
      "type": "text"
    },
    {
      "key": "total_payment",
      "label": "GRID.total_amount",
      "type": "number"
    }
