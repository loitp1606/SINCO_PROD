{
	"id": "goodsReceipt",
	"title": "Phiếu nhập hàng",
	"headers": [
		{
			"key": "idGui",
			"label": "ID",
			"type": "text",
			"hidden": true,
			"sortable": true
		},
		{
			"key": "voucherNumber",
			"label": "Số phiếu nhập hàng",
			"type": "text",
			"width": "100px"
		},
		{
			"key": "voucherDate",
			"label": "Ngày nhập hàng",
			"type": "date",
			"width": "100px"
		},
		{
			"key": "supplierCode",
			"label": "Khách hàng",
			"type": "lookup",
			"width": "350px"
		},
		{
			"key": "totalPayment",
			"label": "GRID.total_amount",
			"type": "number",
			"width": "100px"
		},
		{
			"key": "status",
			"label": "Trạng thái",
			"type": "select",
			"width": "150px",
			"options": [
				{
					"label": "Đang chờ nhập",
					"value": "0"
				},
				{
					"label": "Đã nhập hàng",
					"value": "1"
				}
			]
		},
		{
			"key": "poin_number",
			"label": "Số ĐHN",
			"type": "text",
			"width": "100px"
		},
		{
			"key": "ds_hoa_don",
			"label": "Danh sách hóa đơn",
			"type": "text",
			"width": "150px"
		},
		{
			"key": "paidAmount",
			"label": "Đã thanh toán",
			"type": "number",
			"width": "100px"
		},
		{
			"key": "debtAmount",
			"label": "Còn phải trả",
			"type": "number",
			"width": "100px"
		},
		{
			"key": "note",
			"label": "Ghi chú",
			"type": "text",
			"width": "150px"
		}
	],
	"query": {
		"formId": {
			"controller": "goodsReceipt.page.json",
			"formId": "goodsReceipt",
			"primaryKey": [
				"idGui"
			],
			"type": "voucher",
			"action": "loading",
			"idVC": "Z10",
			"value": [],
			"listTable": [
				"goodsReceipt",
				"goodsReceiptDetail"
			],
			"VCDate": "",
			"isFileHandle": "export",
			"enableTaxExcelExport": true,
			"taxExcelExportConfig": "goodsReceipt"
		}
	},
	"sort": "voucherDate desc, voucherNumber desc",
	"ui": {
		"summary": {
			"field": "totalPayment",
			"label": "Tổng tiền",
			"format": "number"
		}
	},
	"actions": [
		{
			"controller": "paymentSlip",
			"id": "paymentSlip.page.json",
			"label": "Tạo phiếu chi",
			"target": "paymentslip/popup",
			"color": "orange"
		},
		{
			"controller": "OrderReturn",
			"id": "orderReturn.page.json",
			"label": "Tạo phiếu xuất trả hàng",
			"target": "orderReturn/popup",
			"color": "orange"
		}
	]
}
